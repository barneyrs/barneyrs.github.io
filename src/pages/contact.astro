---
import BaseLayout from '../layouts/BaseLayout.astro'
import { Image } from 'astro:assets'
import mandolinImage from '../assets/mandolin.jpg';
---

<BaseLayout>
	<main class="app-container pt-36">
		<h1 class="text-6xl pb-2 font-bold">Contact</h1>
	</main>
	<section class="app-container py-12 mb-8">
		<div
			class="prose prose-neutral prose-lg md:prose-xl dark:prose-invert prose-img:rounded-xl prose-figure:text-center prose-img:mx-auto"
		>
    <p>For any enquiries, get in touch at <a href="mailto:barney@barneyrs.com">barney@barneyrs.com</a>.</p>
		</div>
	</section>
  <!--Image src={mandolinImage} alt="A bird sitting on a nest of eggs." /-->
  
</BaseLayout>
